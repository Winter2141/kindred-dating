{
  "name": "Kindred",
  "short_name": "Kindred",
  "description": "Meet people who share your weekends, not just your postcode.",
  "start_url": "/app/discover",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#120d0c",
  "theme_color": "#120d0c",
  "categories": ["social", "lifestyle"],
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Chats", "url": "/app/matches", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Likes you", "url": "/app/likes", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ]
}
