# Copy to backend/.env and adjust. Every setting can also be passed as an environment variable.
KINDRED_SECRET_KEY=change-me-to-a-long-random-string
KINDRED_DATABASE_URL=sqlite+aiosqlite:///./kindred.db
KINDRED_CORS_ORIGINS=["http://localhost:5173"]
# Seeded personas like you back and reply in chat. Turn off for a "real" deployment.
KINDRED_DEMO_MODE=true
KINDRED_SEED_ON_STARTUP=true
# Fan real-time events out through Redis to run several API workers (pip install ".[redis]").
# KINDRED_REDIS_URL=redis://localhost:6379/0
# Links in emails point here. Email goes to an outbox table unless you configure SMTP.
KINDRED_APP_URL=http://localhost:5173
# KINDRED_MAIL_BACKEND=smtp
# KINDRED_SMTP_HOST=smtp.example.com
# KINDRED_SMTP_USERNAME=...
# KINDRED_SMTP_PASSWORD=...
# Local development only: read outbox emails (with their links) at /api/dev/outbox.
KINDRED_EXPOSE_OUTBOX=true
# One JSON object per log line (with request ids), and a token for GET /metrics.
# KINDRED_LOG_FORMAT=json
# KINDRED_METRICS_TOKEN=...
